# qBittorrent on TrueNAS — change the IP to your TrueNAS machine
QB_URL=http://192.168.1.100:8080
QB_USERNAME=admin
QB_PASSWORD=your_qbittorrent_password

# Local PostgreSQL (used by the collector and web UI)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=qbittorrent_stats
POSTGRES_USER=qbittorrent_stats
POSTGRES_PASSWORD=password

# TrueNAS PostgreSQL (used by `make db-dump` to load real data locally)
TRUENAS_POSTGRES_HOST=truenas
TRUENAS_POSTGRES_PORT=5432
TRUENAS_POSTGRES_DB=qbittorrent_stats
TRUENAS_POSTGRES_USER=qbittorrent_stats
TRUENAS_POSTGRES_PASSWORD=your_truenas_db_password

# Interval settings
INTERVAL_SECONDS=900
TRACKER_REFRESH_SECONDS=86400
LOG_LEVEL=INFO

# Web server
WEB_PORT=8080
